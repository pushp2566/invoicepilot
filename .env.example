# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal Developer Dashboard -> Apps & Credentials -> (Sandbox) your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Google AI Studio -> Get API key (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Name shown on invoices as the sender
INVOICER_NAME=Ashish Kumar

PORT=3000
